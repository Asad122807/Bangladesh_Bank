<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section3.group29.simulatingoperationsofbangladeshbank.Asad.LiquiditySupportRequestController">
    <children>
        <!-- BACK BUTTON ADDED HERE -->
        <Button layoutX="485.0" layoutY="330.0" mnemonicParsing="false" onAction="#handleBackButton" prefHeight="25.0" prefWidth="60.0" text="Back" textFill="#280303" />

        <Label layoutX="162.0" layoutY="25.0" text="Emergency Liquidity Support">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <Label layoutX="50.0" layoutY="85.0" text="Pending Requests:">
            <font>
                <Font size="14.0" />
            </font>
        </Label>

        <!-- Here is your ComboBox -->
        <ComboBox fx:id="bankComboBox" layoutX="175.0" layoutY="82.0" prefHeight="25.0" prefWidth="215.0" promptText="Select Commercial Bank" />

        <Button layoutX="415.0" layoutY="82.0" mnemonicParsing="false" onAction="#handleFetchData" prefHeight="25.0" prefWidth="100.0" text="Fetch Data" />

        <Label layoutX="50.0" layoutY="135.0" text="Bank Health Details (Liquidity, Capital Adequacy, etc.):">
            <font>
                <Font size="13.0" />
            </font>
        </Label>

        <TextArea fx:id="dataDisplayArea" editable="false" layoutX="50.0" layoutY="165.0" prefHeight="130.0" prefWidth="500.0" promptText="Select a bank and click 'Fetch Data' to view reports..." wrapText="true">
            <font>
                <Font size="14.0" />
            </font>
        </TextArea>

        <Button layoutX="175.0" layoutY="325.0" mnemonicParsing="false" onAction="#handleApprove" prefHeight="35.0" prefWidth="110.0" style="-fx-background-color: green;" text="Approve" textFill="WHITE">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Button>

        <Button layoutX="315.0" layoutY="325.0" mnemonicParsing="false" onAction="#handleReject" prefHeight="35.0" prefWidth="110.0" style="-fx-background-color: red;" text="Reject" textFill="#eeeaea">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Button>
    </children>
</AnchorPane>
