<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section3.group29.simulatingoperationsofbangladeshbank.Asad.GovernorController">
    <children>
        <!-- Dashboard Header -->
        <Label layoutX="180.0" layoutY="25.0" text="Governor Dashboard">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <Label layoutX="195.0" layoutY="65.0" text="Select a task module to manage:">
            <font>
                <Font size="13.0" />
            </font>
        </Label>

        <!-- Navigation Buttons -->
        <Button layoutX="165.0" layoutY="105.0" mnemonicParsing="false" onAction="#handleMonetaryPolicy" prefHeight="38.0" prefWidth="270.0" text="Monetary Policy Management" />

        <Button layoutX="165.0" layoutY="158.0" mnemonicParsing="false" onAction="#handleForeignReserveReport" prefHeight="38.0" prefWidth="270.0" text="Foreign Exchange Reserve Report" />

        <Button layoutX="165.0" layoutY="211.0" mnemonicParsing="false" onAction="#handleLiquiditySupportRequest" prefHeight="38.0" prefWidth="270.0" text="Emergency Liquidity Support Request" />

        <Button layoutX="165.0" layoutY="264.0" mnemonicParsing="false" onAction="#handleDepartmentTask" prefHeight="38.0" prefWidth="270.0" text="Department Task Assignment" />

        <!-- Logout Button -->
        <Button layoutX="250.0" layoutY="330.0" mnemonicParsing="false" onAction="#handleLogout" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #d9534f;" text="Log Out" textFill="WHITE">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Button>
    </children>
</AnchorPane>