<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section3.group29.simulatingoperationsofbangladeshbank.Asrar.BeftnOperationsController">
    <children>

        <!-- Header Title -->
        <Label layoutX="220.0" layoutY="20.0" text="BEFTN Operations Monitoring">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <!-- Filter Controls -->
        <Label layoutX="25.0" layoutY="75.0" text="Batch ID:" />
        <TextField fx:id="batchIdTextField" layoutX="85.0" layoutY="71.0" prefWidth="120.0" promptText="Enter Batch ID..." />

        <Label layoutX="225.0" layoutY="75.0" text="Transfer Type:" />
        <ComboBox fx:id="transferTypeComboBox" layoutX="310.0" layoutY="71.0" prefWidth="120.0" promptText="All Types" />

        <Label layoutX="450.0" layoutY="75.0" text="Settlement Date:" />
        <DatePicker fx:id="settlementDatePicker" layoutX="550.0" layoutY="71.0" prefWidth="120.0" promptText="Select Date" />

        <Button fx:id="filterButton" layoutX="685.0" layoutY="71.0" onAction="#handleFilterAction" text="Filter" />

        <!-- BEFTN Data Table -->
        <TableView fx:id="beftnTableView" layoutX="25.0" layoutY="115.0" prefHeight="420.0" prefWidth="750.0">
            <columns>
                <TableColumn fx:id="batchIdColumn" prefWidth="100.0" text="Batch ID" />
                <TableColumn fx:id="originatingBankColumn" prefWidth="140.0" text="Originating Bank" />
                <TableColumn fx:id="receivingBankColumn" prefWidth="140.0" text="Receiving Bank" />
                <TableColumn fx:id="transferTypeColumn" prefWidth="110.0" text="Type (Credit/Debit)" />
                <TableColumn fx:id="totalAmountColumn" prefWidth="120.0" text="Total Amount (BDT)" />
                <TableColumn fx:id="settlementStatusColumn" prefWidth="140.0" text="Settlement Status" />
            </columns>
        </TableView>

        <!-- Bottom Bar & Navigation -->
        <Label fx:id="totalBatchesLabel" layoutX="25.0" layoutY="552.0" text="Total Batches Processed: 0">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>

        <Button fx:id="refreshButton" layoutX="515.0" layoutY="548.0" onAction="#handleRefreshAction" style="-fx-background-color: #059669;" text="Refresh Operations" textFill="WHITE" />
        <Button fx:id="backButton" layoutX="655.0" layoutY="548.0" onAction="#handleBackAction" prefWidth="120.0" style="-fx-background-color: #DC2626;" text="Back to Dashboard" textFill="WHITE" />

    </children>
</AnchorPane>