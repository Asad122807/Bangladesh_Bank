<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section3.group29.simulatingoperationsofbangladeshbank.Asrar.AmlAlertsController">
    <children>

        <!-- Header Title -->
        <Label layoutX="190.0" layoutY="20.0" text="Money Laundering Alerts Investigation">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <!-- Filter Controls -->
        <Label layoutX="25.0" layoutY="75.0" text="Alert ID:" />
        <TextField fx:id="alertIdTextField" layoutX="80.0" layoutY="71.0" prefWidth="120.0" promptText="Enter Alert ID..." />

        <Label layoutX="220.0" layoutY="75.0" text="Severity:" />
        <ComboBox fx:id="severityComboBox" layoutX="280.0" layoutY="71.0" prefWidth="120.0" promptText="All Levels" />

        <Label layoutX="420.0" layoutY="75.0" text="Date:" />
        <DatePicker fx:id="alertDatePicker" layoutX="460.0" layoutY="71.0" prefWidth="130.0" promptText="Select Date" />

        <Button fx:id="filterButton" layoutX="605.0" layoutY="71.0" onAction="#handleFilterAction" text="Filter" />
        <Button fx:id="refreshButton" layoutX="665.0" layoutY="71.0" onAction="#handleRefreshAction" style="-fx-background-color: #059669;" text="Refresh" textFill="WHITE" />

        <!-- AML Alerts Table View -->
        <TableView fx:id="amlAlertsTableView" layoutX="25.0" layoutY="115.0" prefHeight="420.0" prefWidth="750.0">
            <columns>
                <TableColumn fx:id="alertIdColumn" prefWidth="90.0" text="Alert ID" />
                <TableColumn fx:id="accountNumberColumn" prefWidth="130.0" text="Account No." />
                <TableColumn fx:id="customerNameColumn" prefWidth="140.0" text="Customer Name" />
                <TableColumn fx:id="alertTypeColumn" prefWidth="150.0" text="Alert Type" />
                <TableColumn fx:id="severityColumn" prefWidth="110.0" text="Severity" />
                <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Status" />
            </columns>
        </TableView>

        <!-- Bottom Bar & Action Buttons -->
        <Label fx:id="totalAlertsLabel" layoutX="25.0" layoutY="552.0" text="Total Active Alerts: 0">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>

        <Button fx:id="investigateButton" layoutX="480.0" layoutY="548.0" onAction="#handleInvestigateAction" prefWidth="145.0" style="-fx-background-color: #2563EB;" text="Investigate Selected" textFill="WHITE" />
        <Button fx:id="backButton" layoutX="640.0" layoutY="548.0" onAction="#handleBackAction" prefWidth="135.0" style="-fx-background-color: #DC2626;" text="Back to Dashboard" textFill="WHITE" />

    </children>
</AnchorPane>