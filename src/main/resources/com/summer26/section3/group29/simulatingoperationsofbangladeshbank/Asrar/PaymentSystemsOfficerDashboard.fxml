<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section3.group29.simulatingoperationsofbangladeshbank.Asrar.PaymentSystemsOfficerDashboardController">
    <children>

        <!-- Dashboard Title Header -->
        <Label layoutX="30.0" layoutY="20.0" text="Payment Systems Officer Dashboard">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <Label fx:id="welcomeLabel" layoutX="30.0" layoutY="55.0" text="Welcome back, Officer!" textFill="#555555">
            <font>
                <Font size="14.0" />
            </font>
        </Label>

        <Button fx:id="logoutButton" layoutX="680.0" layoutY="25.0" onAction="#handleLogoutAction" prefWidth="90.0" style="-fx-background-color: #DC2626;" text="Logout" textFill="WHITE" />

        <Line endX="740.0" layoutX="30.0" layoutY="90.0" stroke="#CCCCCC" />

        <!-- Section Title: Navigation Options -->
        <Label layoutX="30.0" layoutY="110.0" text="Payment Operations Navigation">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>

        <!-- Navigation Grid Buttons -->
        <Button fx:id="rtgsButton" layoutX="30.0" layoutY="150.0" onAction="#handleRtgsAction" prefHeight="70.0" prefWidth="230.0" style="-fx-background-color: #2563EB;" text="Monitor RTGS" textFill="WHITE">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Button>

        <Button fx:id="beftnButton" layoutX="285.0" layoutY="150.0" onAction="#handleBeftnAction" prefHeight="70.0" prefWidth="230.0" style="-fx-background-color: #0D9488;" text="BEFTN Operations" textFill="WHITE">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Button>

        <Button fx:id="npsbButton" layoutX="540.0" layoutY="150.0" onAction="#handleNpsbAction" prefHeight="70.0" prefWidth="230.0" style="-fx-background-color: #7C3AED;" text="NPSB Transactions" textFill="WHITE">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Button>

        <Button fx:id="discrepancyButton" layoutX="30.0" layoutY="240.0" onAction="#handleDiscrepancyAction" prefHeight="70.0" prefWidth="230.0" style="-fx-background-color: #D97706;" text="Resolve Settlement Discrepancies" textFill="WHITE">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Button>

        <Line endX="740.0" layoutX="30.0" layoutY="340.0" stroke="#CCCCCC" />

        <!-- Section Title: System Overview / Quick Stats -->
        <Label layoutX="30.0" layoutY="360.0" text="System Quick Summary">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>

        <!-- Stat Cards -->
        <AnchorPane layoutX="30.0" layoutY="400.0" prefHeight="130.0" prefWidth="230.0" style="-fx-background-color: #F3F4F6; -fx-background-radius: 8;">
            <children>
                <Label layoutX="15.0" layoutY="15.0" text="RTGS Active Volume" textFill="#666666">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>
                <Label fx:id="rtgsVolumeLabel" layoutX="15.0" layoutY="45.0" text="BDT 0.00">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
            </children>
        </AnchorPane>

        <AnchorPane layoutX="285.0" layoutY="400.0" prefHeight="130.0" prefWidth="230.0" style="-fx-background-color: #F3F4F6; -fx-background-radius: 8;">
            <children>
                <Label layoutX="15.0" layoutY="15.0" text="BEFTN Batches Today" textFill="#666666">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>
                <Label fx:id="beftnBatchesLabel" layoutX="15.0" layoutY="45.0" text="0 Batches">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
            </children>
        </AnchorPane>

        <AnchorPane layoutX="540.0" layoutY="400.0" prefHeight="130.0" prefWidth="230.0" style="-fx-background-color: #F3F4F6; -fx-background-radius: 8;">
            <children>
                <Label layoutX="15.0" layoutY="15.0" text="Pending Discrepancies" textFill="#666666">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>
                <Label fx:id="discrepancyCountLabel" layoutX="15.0" layoutY="45.0" text="0 Issues" textFill="#DC2626">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
            </children>
        </AnchorPane>

        <!-- Status Footer -->
        <Label fx:id="statusLabel" layoutX="30.0" layoutY="560.0" text="Status: Payment Systems Online" textFill="#059669">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>

    </children>
</AnchorPane>