<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section3.group29.simulatingoperationsofbangladeshbank.Asad.MonetaryPolicyController">
    <children>
        <!-- Title -->
        <Label layoutX="160.0" layoutY="20.0" text="Monetary Policy Management">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <!-- Load Data Button -->
        <Button layoutX="220.0" layoutY="65.0" mnemonicParsing="false" onAction="#handleLoadIndicators" prefHeight="25.0" prefWidth="160.0" text="Load Economic Indicators" />

        <!-- Current Economic Indicators Section -->
        <Label layoutX="50.0" layoutY="105.0" text="Current Economic Indicators:" textFill="#555555">
            <font>
                <Font name="System Bold Italic" size="12.0" />
            </font>
        </Label>

        <Label layoutX="50.0" layoutY="135.0" text="Inflation Rate (%):">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <TextField fx:id="inflationRateField" editable="false" layoutX="165.0" layoutY="130.0" prefHeight="25.0" prefWidth="110.0" promptText="Wait for data..." />

        <Label layoutX="315.0" layoutY="135.0" text="GDP Growth (%):">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <TextField fx:id="gdpGrowthField" editable="false" layoutX="420.0" layoutY="130.0" prefHeight="25.0" prefWidth="110.0" promptText="Wait for data..." />

        <!-- Policy Adjustments Section -->
        <Label layoutX="50.0" layoutY="175.0" text="Policy Rate Adjustments:" textFill="#555555">
            <font>
                <Font name="System Bold Italic" size="12.0" />
            </font>
        </Label>

        <Label layoutX="50.0" layoutY="205.0" text="Target Repo (%):">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <TextField fx:id="repoRateField" layoutX="165.0" layoutY="200.0" prefHeight="25.0" prefWidth="110.0" promptText="e.g., 6.5" />

        <Label layoutX="315.0" layoutY="205.0" text="Reverse Repo (%):">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <TextField fx:id="reverseRepoField" layoutX="420.0" layoutY="200.0" prefHeight="25.0" prefWidth="110.0" promptText="e.g., 4.5" />

        <!-- Policy Justification -->
        <Label layoutX="50.0" layoutY="245.0" text="Policy Justification / Notes:">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <TextArea fx:id="justificationArea" layoutX="50.0" layoutY="265.0" prefHeight="55.0" prefWidth="480.0" promptText="Briefly explain the reason for these monetary policy adjustments..." wrapText="true" />

        <!-- Action Buttons -->
        <Button layoutX="220.0" layoutY="335.0" mnemonicParsing="false" onAction="#handleUpdatePolicy" prefHeight="35.0" prefWidth="160.0" style="-fx-background-color: #0066cc;" text="Update Policy Rates" textFill="WHITE">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Button>

        <!-- Back Button -->
        <Button layoutX="485.0" layoutY="340.0" mnemonicParsing="false" onAction="#handleBackButton" prefHeight="25.0" prefWidth="60.0" text="Back" textFill="#280303" />
    </children>
</AnchorPane>