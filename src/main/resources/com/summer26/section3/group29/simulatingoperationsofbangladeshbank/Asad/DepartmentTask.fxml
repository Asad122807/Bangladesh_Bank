<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section3.group29.simulatingoperationsofbangladeshbank.Asad.DepartmentTaskController">
    <children>
        <Label layoutX="175.0" layoutY="20.0" text="Department Task Assignment">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <!-- Task ID Field -->
        <Label layoutX="50.0" layoutY="75.0" text="Task ID:">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <TextField fx:id="taskIdField" layoutX="120.0" layoutY="70.0" prefHeight="25.0" prefWidth="150.0" promptText="e.g. T-101" />

        <!-- Department Selection -->
        <Label layoutX="320.0" layoutY="75.0" text="Assign To:">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <ComboBox fx:id="departmentComboBox" layoutX="390.0" layoutY="70.0" prefHeight="25.0" prefWidth="160.0" promptText="Select Dept..." />

        <!-- Task Name Field -->
        <Label layoutX="50.0" layoutY="125.0" text="Task Title:">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <TextField fx:id="taskTitleField" layoutX="120.0" layoutY="120.0" prefHeight="25.0" prefWidth="150.0" promptText="Brief title" />

        <!-- Deadline Picker -->
        <Label layoutX="320.0" layoutY="125.0" text="Deadline:">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <DatePicker fx:id="deadlinePicker" layoutX="390.0" layoutY="120.0" prefHeight="25.0" prefWidth="160.0" promptText="Select Date" />

        <!-- Task Description Area -->
        <Label layoutX="50.0" layoutY="175.0" text="Task Details &amp; Instructions:">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <TextArea fx:id="taskDescriptionArea" layoutX="50.0" layoutY="200.0" prefHeight="100.0" prefWidth="500.0" promptText="Provide detailed instructions for the department here..." wrapText="true">
            <font>
                <Font size="13.0" />
            </font>
        </TextArea>

        <!-- Action Buttons -->
        <Button layoutX="120.0" layoutY="330.0" mnemonicParsing="false" onAction="#handleClearForm" prefHeight="35.0" prefWidth="100.0" text="Clear Form" />

        <Button layoutX="240.0" layoutY="330.0" mnemonicParsing="false" onAction="#handleAssignTask" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #0066cc;" text="Assign Task" textFill="WHITE">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Button>

        <!-- Back Button -->
        <Button layoutX="485.0" layoutY="335.0" mnemonicParsing="false" onAction="#handleBackButton" prefHeight="25.0" prefWidth="60.0" text="Back" textFill="#280303" />
    </children>
</AnchorPane>