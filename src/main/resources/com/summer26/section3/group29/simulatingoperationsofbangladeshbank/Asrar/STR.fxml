<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section3.group29.simulatingoperationsofbangladeshbank.Asrar.StrReviewController">
    <children>

        <!-- Header Title -->
        <Label layoutX="210.0" layoutY="20.0" text="Suspicious Transaction Reports (STR)">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <!-- Filter Controls -->
        <Label layoutX="25.0" layoutY="75.0" text="Search Bank:" />
        <TextField fx:id="searchBankTextField" layoutX="100.0" layoutY="71.0" prefWidth="130.0" promptText="Enter bank..." />

        <Label layoutX="245.0" layoutY="75.0" text="Risk Level:" />
        <ComboBox fx:id="riskLevelComboBox" layoutX="315.0" layoutY="71.0" prefWidth="110.0" promptText="All Risks" />

        <Label layoutX="440.0" layoutY="75.0" text="Date:" />
        <DatePicker fx:id="reportDatePicker" layoutX="475.0" layoutY="71.0" prefWidth="120.0" promptText="Select Date" />

        <Button fx:id="filterButton" layoutX="605.0" layoutY="71.0" onAction="#handleFilterAction" text="Filter" />
        <Button fx:id="refreshButton" layoutX="665.0" layoutY="71.0" onAction="#handleRefreshAction" style="-fx-background-color: #059669;" text="Refresh" textFill="WHITE" />

        <!-- STR Table View -->
        <TableView fx:id="strTableView" layoutX="25.0" layoutY="115.0" prefHeight="420.0" prefWidth="750.0">
            <columns>
                <TableColumn fx:id="reportIdColumn" prefWidth="90.0" text="Report ID" />
                <TableColumn fx:id="reportingBankColumn" prefWidth="140.0" text="Reporting Bank" />
                <TableColumn fx:id="customerNameColumn" prefWidth="140.0" text="Customer Name" />
                <TableColumn fx:id="suspicionTypeColumn" prefWidth="150.0" text="Suspicion Type" />
                <TableColumn fx:id="riskLevelColumn" prefWidth="100.0" text="Risk Level" />
                <TableColumn fx:id="dateReportedColumn" prefWidth="120.0" text="Date Reported" />
            </columns>
        </TableView>

        <!-- Bottom Bar & Navigation -->
        <Label fx:id="totalReportsLabel" layoutX="25.0" layoutY="552.0" text="Total Pending Reports: 0">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>

        <Button fx:id="viewDetailsButton" layoutX="495.0" layoutY="548.0" onAction="#handleViewDetailsAction" prefWidth="130.0" style="-fx-background-color: #2563EB;" text="View STR Details" textFill="WHITE" />
        <Button fx:id="backButton" layoutX="640.0" layoutY="548.0" onAction="#handleBackAction" prefWidth="135.0" style="-fx-background-color: #DC2626;" text="Back to Dashboard" textFill="WHITE" />

    </children>
</AnchorPane>