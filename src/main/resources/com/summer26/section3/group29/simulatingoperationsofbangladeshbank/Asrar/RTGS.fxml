<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section3.group29.simulatingoperationsofbangladeshbank.Asrar.RtgsMonitoringController">
    <children>

        <!-- Top Title Label -->
        <Label layoutX="240.0" layoutY="20.0" text="RTGS Transaction Monitoring">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <!-- Search Controls -->
        <Label layoutX="25.0" layoutY="75.0" text="Search Bank:" />
        <TextField fx:id="searchBankTextField" layoutX="105.0" layoutY="71.0" prefWidth="140.0" promptText="Enter bank name..." />

        <Label layoutX="260.0" layoutY="75.0" text="Status:" />
        <ComboBox fx:id="statusComboBox" layoutX="305.0" layoutY="71.0" prefWidth="120.0" promptText="All Statuses" />

        <Label layoutX="440.0" layoutY="75.0" text="Date:" />
        <DatePicker fx:id="transactionDatePicker" layoutX="475.0" layoutY="71.0" prefWidth="130.0" promptText="Select date" />

        <Button fx:id="filterButton" layoutX="620.0" layoutY="71.0" onAction="#handleFilterAction" text="Filter" />
        <Button fx:id="refreshButton" layoutX="680.0" layoutY="71.0" onAction="#handleRefreshAction" style="-fx-background-color: #059669;" text="Refresh" textFill="WHITE" />

        <!-- RTGS Table View -->
        <TableView fx:id="rtgsTableView" layoutX="25.0" layoutY="115.0" prefHeight="420.0" prefWidth="750.0">
            <columns>
                <TableColumn fx:id="txnIdColumn" prefWidth="110.0" text="Transaction ID" />
                <TableColumn fx:id="senderBankColumn" prefWidth="140.0" text="Sender Bank" />
                <TableColumn fx:id="receiverBankColumn" prefWidth="140.0" text="Receiver Bank" />
                <TableColumn fx:id="amountColumn" prefWidth="120.0" text="Amount (BDT)" />
                <TableColumn fx:id="statusColumn" prefWidth="100.0" text="Status" />
                <TableColumn fx:id="timestampColumn" prefWidth="140.0" text="Timestamp" />
            </columns>
        </TableView>

        <!-- Bottom Status & Back Button -->
        <Label fx:id="totalTxnLabel" layoutX="25.0" layoutY="552.0" text="Total Transactions: 0">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>

        <Button fx:id="backButton" layoutX="640.0" layoutY="548.0" onAction="#handleBackAction" prefHeight="26.0" prefWidth="135.0" style="-fx-background-color: #DC2626;" text="Back to Dashboard" textFill="WHITE" />

    </children>
</AnchorPane>