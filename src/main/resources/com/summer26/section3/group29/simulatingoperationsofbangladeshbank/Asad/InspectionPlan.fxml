<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section3.group29.simulatingoperationsofbangladeshbank.Asad.InspectionController">
    <children>
        <!-- Title -->
        <Label layoutX="190.0" layoutY="20.0" text="Bank Inspection Report">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <!-- Target Bank Selection -->
        <Label layoutX="50.0" layoutY="80.0" text="Target Bank:">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <ComboBox fx:id="bankComboBox" layoutX="140.0" layoutY="75.0" prefHeight="25.0" prefWidth="150.0" promptText="Select Bank..." />

        <!-- Inspection Category -->
        <Label layoutX="320.0" layoutY="80.0" text="Category:">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <ComboBox fx:id="categoryComboBox" layoutX="400.0" layoutY="75.0" prefHeight="25.0" prefWidth="150.0" promptText="Select Type..." />

        <!-- Date Picker -->
        <Label layoutX="50.0" layoutY="130.0" text="Inspect Date:">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <DatePicker fx:id="inspectionDate" layoutX="140.0" layoutY="125.0" prefHeight="25.0" prefWidth="150.0" promptText="Pick a date" />

        <!-- Inspector Name/ID -->
        <Label layoutX="320.0" layoutY="130.0" text="Inspector ID:">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <TextField fx:id="inspectorField" layoutX="400.0" layoutY="125.0" prefHeight="25.0" prefWidth="150.0" promptText="e.g. INS-402" />

        <!-- Findings / Remarks Area -->
        <Label layoutX="50.0" layoutY="180.0" text="Inspection Findings &amp; Remarks:">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <TextArea fx:id="remarksArea" layoutX="50.0" layoutY="205.0" prefHeight="100.0" prefWidth="500.0" promptText="Log any regulatory violations, financial health notes, or general findings here..." wrapText="true">
            <font>
                <Font size="13.0" />
            </font>
        </TextArea>

        <!-- Action Buttons -->
        <Button layoutX="140.0" layoutY="330.0" mnemonicParsing="false" onAction="#handleClearForm" prefHeight="35.0" prefWidth="100.0" text="Clear Form" />

        <Button layoutX="260.0" layoutY="330.0" mnemonicParsing="false" onAction="#handleSubmitReport" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: #0066cc;" text="Submit Report" textFill="WHITE">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Button>

        <!-- Back Button -->
        <Button layoutX="490.0" layoutY="335.0" mnemonicParsing="false" onAction="#handleBackButton" prefHeight="25.0" prefWidth="60.0" text="Back" textFill="#280303" />
    </children>
</AnchorPane>