<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section3.group29.simulatingoperationsofbangladeshbank.Asad.ForeignExchangeReportController">
    <children>
        <!-- Title -->
        <Label layoutX="170.0" layoutY="20.0" text="Foreign Exchange Report">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <!-- Report Date -->
        <Label layoutX="50.0" layoutY="75.0" text="Report Date:">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <DatePicker fx:id="reportDatePicker" layoutX="150.0" layoutY="70.0" prefHeight="25.0" prefWidth="140.0" promptText="Select Date" />

        <!-- Currency Selector -->
        <Label layoutX="320.0" layoutY="75.0" text="Base Currency:">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <ComboBox fx:id="currencyComboBox" layoutX="415.0" layoutY="70.0" prefHeight="25.0" prefWidth="135.0" promptText="Select..." />

        <!-- Exchange Rate -->
        <Label layoutX="50.0" layoutY="125.0" text="Exchange Rate (BDT):">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <TextField fx:id="exchangeRateField" layoutX="185.0" layoutY="120.0" prefHeight="25.0" prefWidth="105.0" promptText="e.g. 117.50" />

        <!-- Remittance Inflow -->
        <Label layoutX="320.0" layoutY="125.0" text="Remittance (USD Mn):">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <TextField fx:id="remittanceField" layoutX="445.0" layoutY="120.0" prefHeight="25.0" prefWidth="105.0" promptText="e.g. 2100.5" />

        <!-- Trade Deficit/Surplus -->
        <Label layoutX="50.0" layoutY="175.0" text="Trade Balance (USD Mn):">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <TextField fx:id="tradeBalanceField" layoutX="200.0" layoutY="170.0" prefHeight="25.0" prefWidth="350.0" promptText="e.g. -450.0 (Net Import Deficit)" />

        <!-- Market Observations / Notes -->
        <Label layoutX="50.0" layoutY="220.0" text="Market Observations &amp; Remarks:">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <TextArea fx:id="remarksArea" layoutX="50.0" layoutY="240.0" prefHeight="80.0" prefWidth="500.0" promptText="Enter forex market trends, liquidity interventions, or regulatory observations..." wrapText="true">
            <font>
                <Font size="13.0" />
            </font>
        </TextArea>

        <!-- Action Buttons -->
        <Button layoutX="140.0" layoutY="335.0" mnemonicParsing="false" onAction="#handleClearForm" prefHeight="35.0" prefWidth="100.0" text="Clear Form" />

        <Button layoutX="260.0" layoutY="335.0" mnemonicParsing="false" onAction="#handleSubmitReport" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: #0066cc;" text="Submit FX Report" textFill="WHITE">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Button>

        <!-- Back Button -->
        <Button layoutX="490.0" layoutY="340.0" mnemonicParsing="false" onAction="#handleBackButton" prefHeight="25.0" prefWidth="60.0" text="Back" textFill="#280303" />
    </children>
</AnchorPane>