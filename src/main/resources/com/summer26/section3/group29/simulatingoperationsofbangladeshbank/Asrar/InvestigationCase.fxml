<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section3.group29.simulatingoperationsofbangladeshbank.Asrar.InvestigationCaseController">
    <children>

        <!-- Header Title -->
        <Label layoutX="230.0" layoutY="20.0" text="AML Investigation Cases">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <!-- Filter Controls -->
        <Label layoutX="25.0" layoutY="75.0" text="Case ID:" />
        <TextField fx:id="caseIdTextField" layoutX="80.0" layoutY="71.0" prefWidth="120.0" promptText="Enter Case ID..." />

        <Label layoutX="215.0" layoutY="75.0" text="Status:" />
        <ComboBox fx:id="statusComboBox" layoutX="260.0" layoutY="71.0" prefWidth="120.0" promptText="All Statuses" />

        <Label layoutX="395.0" layoutY="75.0" text="Date:" />
        <DatePicker fx:id="caseDatePicker" layoutX="430.0" layoutY="71.0" prefWidth="130.0" promptText="Select Date" />

        <Button fx:id="filterButton" layoutX="575.0" layoutY="71.0" onAction="#handleFilterAction" text="Filter" />
        <Button fx:id="refreshButton" layoutX="635.0" layoutY="71.0" onAction="#handleRefreshAction" style="-fx-background-color: #059669;" text="Refresh" textFill="WHITE" />

        <!-- Investigation Cases Table View -->
        <TableView fx:id="investigationCasesTableView" layoutX="25.0" layoutY="115.0" prefHeight="420.0" prefWidth="750.0">
            <columns>
                <TableColumn fx:id="caseIdColumn" prefWidth="90.0" text="Case ID" />
                <TableColumn fx:id="caseTitleColumn" prefWidth="150.0" text="Case Title" />
                <TableColumn fx:id="assignedOfficerColumn" prefWidth="130.0" text="Assigned Officer" />
                <TableColumn fx:id="priorityColumn" prefWidth="100.0" text="Priority" />
                <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Status" />
                <TableColumn fx:id="dateOpenedColumn" prefWidth="140.0" text="Date Opened" />
            </columns>
        </TableView>

        <!-- Bottom Status & Actions -->
        <Label fx:id="totalCasesLabel" layoutX="25.0" layoutY="552.0" text="Total Active Cases: 0">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>

        <Button fx:id="openDetailsButton" layoutX="485.0" layoutY="548.0" onAction="#handleOpenDetailsAction" prefWidth="140.0" style="-fx-background-color: #2563EB;" text="Open Case Details" textFill="WHITE" />
        <Button fx:id="backButton" layoutX="640.0" layoutY="548.0" onAction="#handleBackAction" prefWidth="135.0" style="-fx-background-color: #DC2626;" text="Back to Dashboard" textFill="WHITE" />

    </children>
</AnchorPane>