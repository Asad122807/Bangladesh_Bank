<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section3.group29.simulatingoperationsofbangladeshbank.Asrar.DisputeResolutionController">
    <children>

        <!-- Header Title -->
        <Label layoutX="260.0" layoutY="20.0" text="Transaction Dispute Resolution">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <!-- Filter Section -->
        <Label layoutX="25.0" layoutY="70.0" text="Dispute ID / Txn ID:" />
        <TextField fx:id="searchDisputeTextField" layoutX="140.0" layoutY="66.0" prefWidth="140.0" promptText="Enter ID..." />

        <Label layoutX="300.0" layoutY="70.0" text="Status:" />
        <ComboBox fx:id="statusComboBox" layoutX="345.0" layoutY="66.0" prefWidth="130.0" promptText="All Statuses" />

        <Button fx:id="filterButton" layoutX="490.0" layoutY="66.0" onAction="#handleFilterAction" text="Filter" />
        <Button fx:id="refreshButton" layoutX="550.0" layoutY="66.0" onAction="#handleRefreshAction" style="-fx-background-color: #059669;" text="Refresh List" textFill="WHITE" />

        <!-- Disputes Table View -->
        <TableView fx:id="disputesTableView" layoutX="25.0" layoutY="110.0" prefHeight="330.0" prefWidth="750.0">
            <columns>
                <TableColumn fx:id="disputeIdColumn" prefWidth="90.0" text="Dispute ID" />
                <TableColumn fx:id="txnIdColumn" prefWidth="110.0" text="Txn ID" />
                <TableColumn fx:id="complainantBankColumn" prefWidth="140.0" text="Complainant Bank" />
                <TableColumn fx:id="respondentBankColumn" prefWidth="140.0" text="Respondent Bank" />
                <TableColumn fx:id="amountColumn" prefWidth="110.0" text="Amount (BDT)" />
                <TableColumn fx:id="disputeStatusColumn" prefWidth="160.0" text="Dispute Status" />
            </columns>
        </TableView>

        <!-- Action Panel for Dispute Decision -->
        <Label layoutX="25.0" layoutY="460.0" text="Resolution Details / Notes:">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>
        <TextField fx:id="resolutionNoteTextField" layoutX="25.0" layoutY="485.0" prefWidth="480.0" promptText="Enter resolution comments or investigation decision here..." />

        <Button fx:id="resolveDisputeButton" layoutX="520.0" layoutY="485.0" onAction="#handleResolveDisputeAction" prefWidth="120.0" style="-fx-background-color: #2563EB;" text="Resolve Dispute" textFill="WHITE" />
        <Button fx:id="rejectDisputeButton" layoutX="655.0" layoutY="485.0" onAction="#handleRejectDisputeAction" prefWidth="120.0" style="-fx-background-color: #D97706;" text="Reject Dispute" textFill="WHITE" />

        <!-- Navigation & Status -->
        <Label fx:id="statusMessageLabel" layoutX="25.0" layoutY="552.0" text="Select a dispute row above to resolve or view details.">
            <font>
                <Font size="12.0" />
            </font>
        </Label>

        <Button fx:id="backButton" layoutX="640.0" layoutY="548.0" onAction="#handleBackAction" prefWidth="135.0" style="-fx-background-color: #DC2626;" text="Back to Dashboard" textFill="WHITE" />

    </children>
</AnchorPane>