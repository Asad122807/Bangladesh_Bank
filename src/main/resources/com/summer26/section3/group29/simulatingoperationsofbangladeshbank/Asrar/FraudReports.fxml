<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section3.group29.simulatingoperationsofbangladeshbank.Asrar.FraudReportsController">
    <children>

        <!-- Header Title -->
        <Label layoutX="240.0" layoutY="20.0" text="Fraud Detection Reports">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <!-- Filter Controls -->
        <Label layoutX="25.0" layoutY="75.0" text="Fraud ID:" />
        <TextField fx:id="fraudIdTextField" layoutX="85.0" layoutY="71.0" prefWidth="120.0" promptText="Enter ID..." />

        <Label layoutX="225.0" layoutY="75.0" text="Category:" />
        <ComboBox fx:id="categoryComboBox" layoutX="285.0" layoutY="71.0" prefWidth="120.0" promptText="All Categories" />

        <Label layoutX="425.0" layoutY="75.0" text="Date:" />
        <DatePicker fx:id="fraudDatePicker" layoutX="465.0" layoutY="71.0" prefWidth="130.0" promptText="Select Date" />

        <Button fx:id="filterButton" layoutX="610.0" layoutY="71.0" onAction="#handleFilterAction" text="Filter" />
        <Button fx:id="refreshButton" layoutX="670.0" layoutY="71.0" onAction="#handleRefreshAction" style="-fx-background-color: #059669;" text="Refresh" textFill="WHITE" />

        <!-- Fraud Reports Table View -->
        <TableView fx:id="fraudReportsTableView" layoutX="25.0" layoutY="115.0" prefHeight="420.0" prefWidth="750.0">
            <columns>
                <TableColumn fx:id="fraudIdColumn" prefWidth="90.0" text="Fraud ID" />
                <TableColumn fx:id="bankNameColumn" prefWidth="130.0" text="Bank Name" />
                <TableColumn fx:id="categoryColumn" prefWidth="140.0" text="Fraud Category" />
                <TableColumn fx:id="amountColumn" prefWidth="120.0" text="Amount (BDT)" />
                <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Status" />
                <TableColumn fx:id="dateColumn" prefWidth="130.0" text="Date Flagged" />
            </columns>
        </TableView>

        <!-- Bottom Status & Actions -->
        <Label fx:id="totalFraudLabel" layoutX="25.0" layoutY="552.0" text="Total Flagged Fraud Cases: 0">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>

        <Button fx:id="reviewButton" layoutX="485.0" layoutY="548.0" onAction="#handleReviewAction" prefWidth="140.0" style="-fx-background-color: #2563EB;" text="Review Selected" textFill="WHITE" />
        <Button fx:id="backButton" layoutX="640.0" layoutY="548.0" onAction="#handleBackAction" prefWidth="135.0" style="-fx-background-color: #DC2626;" text="Back to Dashboard" textFill="WHITE" />

    </children>
</AnchorPane>